{
  "name": "wecom",
  "version": "1.0.0-rc.2",
  "description": "WeCom / WeChat Work Node.js SDK",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.28.2",
  "repository": {
    "type": "git",
    "url": "git://github.com/witjs/wecom.git"
  },
  "keywords": [
    "企业微信",
    "wecom",
    "wechat-work",
    "sdk",
    "nodejs",
    "typescript"
  ],
  "homepage": "https://witjs.github.io/wecom/",
  "author": "witjs <github@sina.cn>",
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "WECOM_INTEGRATION=1 vitest run test/integration",
    "test:smoke": "node scripts/smoke.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "changeset publish --tag next",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "husky",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^22.18.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,md,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}
